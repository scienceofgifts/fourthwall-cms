# GEMINI_API_KEY: Required for server-side / Worker-side Gemini AI API calls.
# - In Google AI Studio: automatically injected at runtime from user secrets.
# - In local development: set in a local .env file (never commit .env) or .dev.vars for Wrangler.
# - In Cloudflare Workers (workers.dev): configure as an encrypted Worker Secret in the
#   Cloudflare Dashboard (Workers & Pages -> Settings -> Variables and Secrets -> Add Secret)
#   or via CLI: `npx wrangler secret put GEMINI_API_KEY`
# Never expose GEMINI_API_KEY with a VITE_ prefix or in client-side code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted (e.g. https://science-of-gifts-cms.<subdomain>.workers.dev).
APP_URL="MY_APP_URL"

# Cloudflare R2 Image Hosting Configuration (Server-Side Only — NEVER prefix with VITE_)
# Used by /api/images/upload-r2 when uploading optimized WebP product images via the S3-compatible R2 API.
# Note: When running on Cloudflare Workers with an [[r2_buckets]] binding named IMAGES_BUCKET in wrangler.toml,
# the Worker uses the native R2 bucket binding automatically and does not require S3 API keys.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL="https://images.scienceofgifts.com"

# Firebase ID Token Verification & CMS Authorization (Server-Side Only)
# R2 uploads require a cryptographically verified Firebase Authentication ID token from an authorized CMS user.
# Defaults to the projectId in firebase-applet-config.json ("rock-sound-kdtd0") and the project owner emails.
FIREBASE_PROJECT_ID="rock-sound-kdtd0"
CMS_AUTHORIZED_EMAILS=""
CMS_AUTHORIZED_UIDS=""
